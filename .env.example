[TEMPLATE]
# Copy to .env and fill in locally with your own values. Never commit real values.
# TMDB catalog access: create a read access token in your TMDB account settings.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Hosted backend database. Use a least-privilege login (member of odin_api, NOINHERIT)
# over the Supabase session pooler, e.g.
# postgresql://odin_api_login.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=
DATABASE_URL=
# Frontend build-time values (public, but keep them in frontend/.env.local, not Git).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
